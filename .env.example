# Base URL do grupo "cashsave" no painel de APIs do Xano.
# Exemplo: https://<instancia>.n7.xano.io/api:<identificador-do-grupo>
CASH_SAVE_API_URL=

# Ative em produção sob HTTPS; deixe false para desenvolvimento local.
CASH_SAVE_COOKIE_SECURE=false

# IA financeira local (opcional; o navegador nunca acessa o Ollama diretamente).
# O serviço deve escutar apenas localmente.
CASHSAVE_OLLAMA_BASE_URL=http://127.0.0.1:11434
CASHSAVE_OLLAMA_MODEL=llama3.2:3b
CASHSAVE_OLLAMA_TIMEOUT=20
CASHSAVE_OLLAMA_MAX_QUESTION_CHARS=1200
CASHSAVE_OLLAMA_MAX_CONTEXT_CHARS=12000
CASHSAVE_OLLAMA_MAX_HISTORY=8
CASHSAVE_OLLAMA_MAX_RESPONSE_CHARS=4000
CASHSAVE_OLLAMA_MAX_TOKENS=700
